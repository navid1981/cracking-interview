# =============================================================================
# CrackingInterview Environment Variables
# =============================================================================

# Google OAuth (required for Google Sign-In)
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# App Visibility Mode
# "stealth" = Hide from screen sharing apps (Zoom, Teams), screenshots, Dock (macOS), and Taskbar (Windows)
# "normal"  = Standard visibility (default)
APP_VISIBILITY=stealth
