{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "CrackingInterview",
  "version": "1.0.0",
  "identifier": "com.crackinginterview.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "shortDescription": "AI-powered coding interview preparation tool",
    "longDescription": "CrackingInterview helps developers prepare for coding interviews using AI assistants to analyze and solve problems from Chrome browser tabs",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "app": {
    "windows": [
      {
        "title": "CrackingInterview",
        "width": 550,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  }
}
