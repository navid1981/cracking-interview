# Use PayPal's npm registry (has Tauri packages!)
registry=https://npm.dev.paypalinc.com/

# All scopes use PayPal registry
@tauri-apps:registry=https://npm.dev.paypalinc.com/
@types:registry=https://npm.dev.paypalinc.com/
@vitejs:registry=https://npm.dev.paypalinc.com/

# SSL settings for PayPal network
strict-ssl=true
